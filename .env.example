# Port the Node.js web server will listen on
PORT=3000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/smartagri?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas connection string:
MONGODB_URI=

# Device Configuration
DEFAULT_DEVICE_ID=smartfarm-01
DRY_THRESHOLD=3000
